# Copy to .env (gitignored) and fill in. The server reads .env at start-up; real environment variables win.

# Lyrics: an Anthropic or OpenAI API key turns on writing and rewording lyrics.
FRETCASE_TEXT_MODEL_KEY=
# Optional: which API (unset: sk-ant-... keys use Anthropic, any other key an OpenAI-compatible API),
# another model, or a compatible endpoint.
# FRETCASE_TEXT_MODEL_API=openai
# FRETCASE_TEXT_MODEL_NAME=gpt-5-mini
# FRETCASE_TEXT_MODEL_URL=https://api.openai.com/v1

# Where the QR code points; default is this server's own address.
# FRETCASE_SHARE_BASE=https://fretcase.local:8443

# dry_run (default), instax, instax:<BLE address>, thermal:usb:<vid>:<pid>
# FRETCASE_PRINTER=dry_run

# The studio version: Google Lyria through the Gemini API sings the whole song (about $0.08 a song).
# Get a key at https://aistudio.google.com/apikey. Unset, the studio version answers 503 not_configured.
FRETCASE_MUSIC_MODEL_KEY=
# FRETCASE_MUSIC_MODEL_NAME=lyria-3.5        # or lyria-3-clip-preview for a 30-second clip
# FRETCASE_RENDER_TIMEOUT=240
