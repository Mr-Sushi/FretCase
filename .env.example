# Copy to .env (gitignored) and fill in. The server reads .env at start-up; real environment variables win.

# Lyrics: an Anthropic API key turns on writing and rewording lyrics.
FRETCASE_TEXT_MODEL_KEY=
# Optional: another model or a compatible endpoint.
# FRETCASE_TEXT_MODEL_NAME=claude-sonnet-5-5
# FRETCASE_TEXT_MODEL_URL=https://api.anthropic.com

# Where the QR code points; default is this server's own address.
# FRETCASE_SHARE_BASE=https://fretcase.local:8443

# dry_run (default), instax, instax:<BLE address>, thermal:usb:<vid>:<pid>
# FRETCASE_PRINTER=dry_run
