{
  "name": "fretcase-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/sync-shared.mjs",
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
